{
    "name": "qingkuai-mcp-server",
    "version": "1.0.10",
    "type": "module",
    "author": "mlgq",
    "license": "MIT",
    "main": "dist/index.mjs",
    "homepage": "https://qingkuai.dev",
    "mcpName": "io.github.qingkuai-js/qingkuai-mcp-server",
    "bin": {
        "qingkuai-mcp-server": "dist/index.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/qingkuai-js/language-features"
    },
    "exports": {
        ".": "./dist/index.mjs"
    },
    "files": [
        "assets",
        "server.json",
        "dist/index.mjs"
    ],
    "scripts": {
        "prepublishOnly": "node ../../scripts/enforce-pnpm-publish.mjs",
        "inspect": "mcp-inspector",
        "verifydocs": "tsx scripts/verify-search.ts",
        "copydocs": "tsx scripts/copy-docs.ts && npm run verifydocs"
    },
    "dependencies": {
        "prettier": "catalog:",
        "prettier-plugin-qingkuai": "catalog:",
        "qingkuai": "catalog:"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^0.22.0",
        "@modelcontextprotocol/sdk": "catalog:",
        "zod": "^4.3.6"
    },
    "keywords": [
        "mcp",
        "ai-tools",
        "qingkuai",
        "qk",
        "compiler",
        "formatter",
        "model-context-protocol"
    ],
    "description": "MCP server for Qingkuai (.qk) — provides syntax docs search, syntax checking, compilation, and code formatting tools for AI agents."
}
